{
    "manifest_version": 3,
    "name": "ROCIO",
    "version": "1.0.0",
    "description": "Extensión que facilita la interacción de personas mayores con sistemas web",
    "permissions": ["activeTab", "scripting", "tabs"],
    "host_permissions": ["<all_urls>"],
    "background": {
      "service_worker": "core/background.js"
    },
    "action": {
      "default_popup": "",
      "default_icon": {
        "16": "icons/icon.png",
        "48": "icons/icon.png",
        "128": "icons/icon.png"
      }
    },
    "content_scripts": [
      {
        "matches": ["<all_urls>"],
        "js": ["dist/content.bundle.js"]
      }
    ],
    "icons": {
      "16": "icons/icon.png",
      "48": "icons/icon.png",
      "128": "icons/icon.png"
    }
  }